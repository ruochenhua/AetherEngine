SceneDescription(
    name: "Textured Water",
    camera: (
        position: (0.0, 5.0, 18.0),
        // Face the water and the objects used to judge its reflection/distortion.
        yaw: -1.57,
        pitch: -0.20,
        fov: 60.0,
    ),
    ambient: 0.05,
    lights: [(
        light_type: Directional,
        direction: (0.3, -0.7, -0.6),
        color: (1.0, 0.95, 0.85),
        intensity: 2.0,
    )],
    atmosphere: Some((
        sun_direction: (-0.3, 0.7, 0.6),
        planet_radius: 6360.0,
        atmosphere_height: 100.0,
        rayleigh_scattering: (0.005802, 0.013558, 0.033100),
        mie_asymmetry: 0.758,
        sun_intensity: 8.0,
    )),
    // This fixture isolates the textured water surface. Shoreline/terrain
    // interaction is covered by scenes/12_water.ron and 20_terrain_water_clouds.
    terrain: None,
    water: Some((
        level: -0.5,
        wave_direction: (1.0, 0.5),
        wave_amplitude: 0.4,
        wave_wavelength: 10.0,
        wave_speed: 1.5,
        wave_steepness: 0.5,
        water_color: (0.0, 0.35, 0.45),
        deep_color: (0.0, 0.15, 0.25),
        fresnel_power: 3.0,
        refraction_scale: 0.04,
        reflectivity: 0.6,
        dudv_map: Some("assets/textures/water/waterDUDV.png"),
        normal_map: Some("assets/textures/water/waterNormal.png"),
        texture_scale: 6.0,
        dudv_strength: 0.12,
        normal_strength: 1.2,
        depth_scale: 0.12,
        specular_power: 128.0,
        secondary_scale: 0.7,
        flow_speed: (0.03, 0.01),
        flow_speed_2: (-0.02, 0.015),
        reflection_enabled: true,
        reflection_resolution_scale: 0.5,
    )),
    objects: [
        // Colored, above-water subjects make the planar reflection legible.
        (
            name: "RedMarker",
            mesh: Builtin("cube"),
            transform: (
                translation: (-3.0, 2.5, -2.0),
                scale: (1.3, 2.5, 1.3),
            ),
            material: (
                albedo: (0.9, 0.08, 0.04, 1.0),
                roughness: 0.28,
                metallic: 0.1,
            ),
        ),
        (
            name: "BlueMarker",
            mesh: Builtin("sphere"),
            transform: (
                translation: (3.0, 2.3, -4.0),
                scale: (1.5, 1.5, 1.5),
            ),
            material: (
                albedo: (0.03, 0.32, 0.9, 1.0),
                roughness: 0.22,
                metallic: 0.15,
            ),
        ),
    ],
)
