# Simple UV-mapped quad for file mesh testing.
# Winding produces a normal facing -Z so the front face is visible from the
# default camera position at +Z.

v -1.0 -1.0 0.0
v  1.0 -1.0 0.0
v  1.0  1.0 0.0
v -1.0  1.0 0.0

vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0

vn 0.0 0.0 -1.0

f 1/1/1 3/3/1 2/2/1
f 1/1/1 4/4/1 3/3/1
